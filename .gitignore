# Виртуальное окружение
venv/
env/
.env/
.venv/

# Файлы Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Файлы данных — НЕ ЗАЛИВАЕМ!
# Игнорируем всё внутри папки данных
backend/data/*

# Исключение: разрешаем только файл пресетов
!backend/data/presets.json

# Гарантированно игнорируем все пользовательские папки и файлы
backend/data/chats/
backend/data/backgrounds/
backend/data/avatars/
backend/data/characters.json
backend/data/personas.json
backend/data/lorebooks.json
backend/data/chats_index.json
backend/data/background.json
backend/data/settings.json
# Логи и временные файлы
*.log
*.tmp
*.bak

# IDE
.vscode/
.idea/
*.swp
*.swo

# Настройки окружения
.env
.env.local

# Сборка и дистрибутивы
dist/
build/
*.egg-info/

